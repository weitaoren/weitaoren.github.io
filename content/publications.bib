@article{chen2026searchrewards,
	selected = {true},
	title = {Optimal Return Policies with Heterogeneous Search Rewards},
	author = {Chen, Fangruo and Ren, Weitao* and Xiao, Wenqiang},
	journal = {Production and Operations Management},
	year = {2026},
	month = {10},
	doi = {10.1177/10591478261504549},
	url = {https://doi.org/10.1177/10591478261504549},
	abstract = {This paper studies return policy design for an online seller serving consumers who can resolve product-fit uncertainty through costly pre-purchase search, with search rewards varying across consumers. Return policies shape not only post-purchase return behavior but also ex-ante search and purchase decisions, thereby generating endogenous consumer segmentation. One might expect that inexpensive search would reduce the seller's incentive to offer a generous refund. In our baseline model, however, we show that full refund outperforms no refund when search costs are sufficiently low. We trace this result to a fundamental trade-off in implementing a full-refund policy: the search-relief effect versus the return-inducing effect. Full refund substitutes for search by allowing consumers who would otherwise search to purchase directly and evaluate fit after purchase, thereby removing their search-based information advantage and restoring the seller's pricing power. However, it also induces returns from consumers who would otherwise purchase without search and keep the product, sacrificing the revenue generated by their tolerance for misfit. When search costs are sufficiently low, most consumers would otherwise search, and the search-relief effect therefore dominates the return-inducing effect. As search costs fall further, full refund can also achieve a win-win outcome, indicating that pre-purchase search may be socially inefficient. These findings explain when and why sellers may optimally discourage ex-ante search in favor of ex-post product evaluation.},
	keywords = {Return Policy, Consumer Search, Product Fit, Online Retailing}
}

@article{ren2026fullrefunds,
	selected = {true},
	display_month = {3},
	title = {Why Full Refunds Prevail: A Product Fit Perspective},
	author = {Ren, Weitao and Ru, Chuanshuai* and Xiao, Wenqiang and Chen, Fangruo},
	journal = {Production and Operations Management},
	year = {2026},
	month = {10},
	volume = {35},
	number = {10},
	pages = {3715--3729},
	doi = {10.1177/10591478261442318},
	url = {https://doi.org/10.1177/10591478261442318},
	abstract = {This paper studies how an online seller designs a menu of return contracts to manage consumer heterogeneity arising from product misfit risk. In the model, informed consumers know the product fits, whereas uninformed consumers face uncertainty about fit. We show that when only misfit risk exists, a single full-refund contract can implement the optimal menu. The return price insures consumers against misfit, and the selling price extracts full surplus. This finding aligns with the widespread adoption of lenient return policies and demonstrates that uniform contracts can emerge endogenously from incentive compatibility rather than as ad hoc assumptions. Introducing quality risk---an additional source of uncertainty in the valuation of fit products---fundamentally changes this outcome. The seller then shifts from full to partial refunds. Under high quality risk, the optimal menu becomes differentiated: a low-price, no-frills option for informed consumers and a high-price, insurance-heavy option for uninformed consumers. To induce self-selection, the seller distorts the return price upward for uninformed consumers to strengthen the insurance effect, trading off allocative efficiency for screening. Interestingly, when quality risk becomes extreme, refunds not only mitigate information rents but also enhance social surplus by preventing consumers from retaining low-quality products. Extensions incorporating misfit valuation, seller-side costs, and return hassle costs show that the uniform contract remains robust when only misfit risk is present, rationalizing diverse return policy practices in online markets.},
	keywords = {Return Policy, Product Fit, Online Retailing, Operations--Marketing Interface}
}
